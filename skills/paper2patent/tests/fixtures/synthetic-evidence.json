      "claim_numbers": [
        1,
        2
      ],
      "specification_locator": {
        "anchor": "S103"
      },
      "figure_node_ids": [
        "图1:s103"
      ]
    },
    {
      "feature_id": "F4",
      "description": "窗口均值公式",
      "source_id": "P1",
      "locator": {
        "start_line": 6,
        "end_line": 6
      },
      "source_quote": "S104 对当前完整窗口计算均值m_k=(1/N)Σ_{j=1}^{N}x_j，其中x_j为窗口内数值。",
