{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patent evidence map",
  "type": "object",
  "required": [
    "sources",
    "features"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "kind"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "paper",
              "supplement",
              "original_technical",
              "draft",
              "patent_text",
              "background"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "inline_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "text_source": {
            "enum": [
              "file",
              "inline"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "inline_text"
            ]
          }
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "description",
          "support_status"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "support_status": {
            "enum": [
              "supported",
              "unverified",
              "missing"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "$ref": "#/$defs/sourceLocator"
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claim_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "specification_locator": {
            "$ref": "#/$defs/specLocator"
          },
          "figure_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "support_status": {
                  "const": "supported"
                }
              }
            },
            "then": {
              "required": [
                "source_id",
                "locator"
              ]
            }
          }
        ]
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "source_id",
          "locator"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "$ref": "#/$defs/sourceLocator"
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "conditions": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonical_name"
        ],
        "properties": {
          "canonical_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "short_label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reference_number": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "figure_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "figure_no",
          "source_node",
          "target_node",
          "specification_locator"
        ],
        "properties": {
          "figure_no": {
            "type": "string",
            "minLength": 1
          },
          "source_node": {
            "type": "string",
            "minLength": 1
          },
          "target_node": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "specification_locator": {
            "$ref": "#/$defs/specLocator"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "figure_no",
          "path"
        ],
        "properties": {
          "figure_no": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "renderer": {
            "enum": [
              "bundled",
              "external"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "spec_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "sourceLocator": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "object",
          "required": [
            "start_line"
          ],
          "additionalProperties": false,
          "properties": {
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "page"
          ],
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "section": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "specLocator": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "object",
          "required": [
            "anchor"
          ],
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
